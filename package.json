  "scripts": {
    "dev": "next",
    "build": "npm run fetch-docs && npm run build-search-index && next build && npm run generate-md-routes",
    "generate-md-routes": "npx ts-node --compilerOptions '{\"module\":\"commonjs\"}' scripts/generate-md-routes.ts",
    "build-search-index": "npx ts-node --compilerOptions '{\"module\":\"commonjs\"}' scripts/build-search-index.ts",
    "start": "next start",
    "fetch-docs": "./scripts/fetch-l4-docs.sh"
  },
  "dependencies": {
    "@workos-inc/widgets": "^1.20.0",
    "classnames": "^2.5.1",
    "date-fns": "^3.3.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.17.0",
    "next": "^16.4.1",
    "react": "^18",
    "react-dom": "^18",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
